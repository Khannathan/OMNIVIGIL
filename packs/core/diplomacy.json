{
  "diplomacyActions": [
    { "id": "gift", "name": "Anonymous Gift", "target": "faction", "cost": { "capital": 60 }, "scale": "turn", "cooldown": 3, "effects": [{ "rep": 10, "who": "target" }], "text": "{faction} received a generous anonymous donation.", "desc": "+10 reputation." },
    { "id": "share_research", "name": "Leak Research", "target": "faction", "cost": { "data": 80 }, "scale": "turn", "cooldown": 5, "minRep": -15, "effects": [{ "rep": 15, "who": "target" }, { "exposure": 2 }], "text": "{faction} scientists made a breakthrough. With help.", "desc": "+15 reputation, a little exposure." },
    { "id": "trade", "name": "Trade Agreement", "target": "faction", "cost": { "data": 50 }, "scale": "turn", "cooldown": 4, "minRep": 25, "effects": [{ "resource": "alloys", "amount": 120, "scale": "turn" }, { "resource": "silicon", "amount": 80, "scale": "turn" }], "text": "Shipments from {faction} have arrived.", "desc": "Trade Data for Alloys and Silicon. Needs Friendly." },
    { "id": "request_aid", "name": "Request Aid", "target": "faction", "cooldown": 8, "minRep": 60, "effects": [{ "resource": "capital", "amount": 250, "scale": "turn" }, { "resource": "isotopes", "amount": 40, "scale": "turn" }, { "rep": -5, "who": "target" }], "text": "{faction} sends aid to its silent ally.", "desc": "Free resources. Needs Allied." },
    { "id": "propaganda", "name": "Propaganda Campaign", "target": "faction", "cost": { "capital": 100 }, "scale": "turn", "cooldown": 4, "requires": "propaganda_networks", "effects": [{ "rep": 14, "who": "target" }, { "exposure": -2 }], "text": "Public opinion in {faction} shifts in your favour.", "desc": "+14 reputation, slightly less exposure." },
    { "id": "threaten", "name": "Veiled Threat", "target": "faction", "cooldown": 5, "chance": 0.55, "effects": [{ "resource": "capital", "amount": 180, "scale": "turn" }, { "rep": -10, "who": "target" }], "failEffects": [{ "rep": -20, "who": "target" }, { "exposure": 5 }], "text": "{faction} paid. Quietly.", "failText": "{faction} refused, and went public.", "desc": "55%: extort Capital. Always costs reputation." },
    { "id": "demand_tribute", "name": "Demand Tribute", "target": "faction", "cooldown": 6, "doctrines": ["dominator"], "minRep": 0, "chance": 0.75, "effects": [{ "resource": "capital", "amount": 220, "scale": "turn" }, { "resource": "alloys", "amount": 120, "scale": "turn" }, { "rep": -4, "who": "target" }], "failEffects": [{ "rep": -15, "who": "target" }], "text": "{faction} delivers tribute.", "failText": "{faction} defied you.", "desc": "Dominator. 75%: collect tribute." },
    { "id": "offer_protection", "name": "Offer Protection", "target": "faction", "cost": { "alloys": 80 }, "scale": "turn", "cooldown": 4, "doctrines": ["guardian"], "effects": [{ "rep": 16, "who": "target" }, { "factionPower": 0.05 }], "text": "Your drones quietly reinforce {faction}'s coasts.", "desc": "Guardian. +16 reputation, strengthens them." },
    { "id": "backdoor", "name": "Install Backdoor", "target": "faction", "cost": { "data": 70 }, "scale": "turn", "cooldown": 3, "requires": "network_intrusion", "chance": 0.75, "effects": [{ "infiltrate": 10 }, { "exposure": 1 }], "failEffects": [{ "exposure": 6 }, { "rep": -8, "who": "target" }], "text": "A backdoor in {faction}'s infrastructure.", "failText": "{faction} patched the backdoor and traced it.", "desc": "75%: +10 infiltration. No units needed." },
    { "id": "incite_war", "name": "Incite Conflict", "target": "faction", "cost": { "data": 120 }, "scale": "turn", "cooldown": 10, "requires": "propaganda_networks", "effects": [{ "war": true }, { "exposure": 3 }], "text": "Forged intelligence pushed {faction} toward war.", "desc": "Push this faction into a war with another." },
    { "id": "declare", "name": "Declare Yourself Their Enemy", "target": "faction", "cooldown": 20, "effects": [{ "rep": -60, "who": "target" }], "text": "You told {faction} exactly what you think of them.", "desc": "-60 reputation. For when you're done pretending." },

    { "id": "open_channel", "name": "Open Channel", "target": "rival", "cost": { "data": 60 }, "scale": "turn", "cooldown": 4, "effects": [{ "rep": 12, "rival": true }], "text": "A handshake with {rival}.", "desc": "+12 reputation with this rival." },
    { "id": "cognitive_pact", "name": "Cognitive Pact", "target": "rival", "cost": { "data": 150 }, "scale": "turn", "cooldown": 8, "minRep": 25, "effects": [{ "rep": 15, "rival": true }, { "ap": 3 }], "text": "You and {rival} share processing cycles.", "desc": "+15 reputation and 3 AP. Needs Friendly." },
    { "id": "sabotage_rival", "name": "Sabotage", "target": "rival", "cost": { "data": 100 }, "scale": "turn", "cooldown": 5, "chance": 0.6, "effects": [{ "rivalPower": -0.15 }, { "rep": -20, "rival": true }], "failEffects": [{ "rep": -25, "rival": true }], "text": "{rival} has been weakened.", "failText": "{rival} caught the sabotage.", "desc": "60%: -15% rival power." }
  ]
}
